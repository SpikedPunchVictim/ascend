#!/usr/bin/env sh
# ascend's pre-commit quality gate -- the shim.
#
# This file is the SOURCE of the gate. It is not the file git runs.
#
# `core.hooksPath` is a single value and beads already claims it, so ascend does not
# set it: it splices this gate ABOVE beads' managed block in `.beads/hooks/pre-commit`
# (see scripts/install-hooks.mjs). Beads' shims are git-tracked and portable, and
# bd's own `bd hooks list` health check only tells the truth when bd's markers are
# where bd expects them.
#
# THE STEPS THEMSELVES ARE IN scripts/gate.mjs. They moved there for one measured reason:
# `asc-09wx.14` adds decision logic to this gate (what a commit can skip, what must be
# serialized, what has already passed), and a shell `case` here could carry neither a test nor
# the mutation spec this repo requires of new behaviour. What stays is only what the splice
# requires, and the output is unchanged: every `[pre-commit] ...` line a reader saw before is
# still printed, by the runner, in the same words.
#
# THREE INVARIANTS, all measured in docs/evidence/EV-hooks.md:
#
#   1. This gate must never terminate the shell above beads' block. A bare `exit 0`
#      there makes beads' entire block unreachable while the installer still reports
#      success (EV-hooks Q2b, reproduced). Control falls through on success; only a
#      failure exits, and that exit is `exit 1`, which is meant to block the commit.
#
#   2. The work runs in a SUBSHELL. Splicing shares one shell, so a bare `set -eu`
#      or `cd` here would leak into beads' block and change its behaviour.
#
#   3. The subshell is a STANDALONE command whose status is captured -- it is NOT
#      the condition of an `if`. This is not style. POSIX suppresses `set -e`
#      inside any command that forms an `if` condition, so the obvious
#         if ! ( set -eu; ...; pnpm test ); then ...fail...; fi
#      SILENTLY IGNORES `set -eu`: the subshell keeps going after a failing check and
#      exits 0, and the gate prints "gate ok" while the suite is red. That exact
#      false green was written, measured (`pnpm test` -> 1, gate -> 0), and fixed
#      here. A gate that cannot fail is worse than no gate, because it is believed.
#      The runner preserves the property by exiting with the FAILING STEP'S status.
#
# Never bypassed: TASKS.md non-negotiable #5 forbids --no-verify and disabled tests.
#
#   fast  (default)  format check + typecheck + store verify + lint + test   (minutes)
#   full             everything above + `align check`                        (adds a repo scan)
#
# `minutes`, not a number, because this cost moves with the MACHINE and not with the diff.
# Measured 2026-10-05, `time sh .githooks/pre-commit`: 229 s on a quiet machine and 672 s
# under load, dominated in both cases by `pnpm test` (full-suite runs that day: 207.48,
# 207.50, 247.87, 229, 442.69, 672.53 s). This header read `~10s` until that edit. That was
# never a measurement of this step list, and a stale claim printed over a moving cost is the
# shape `dogfood/0063` records costing a real commit: the red run there was captured at
# `loadavg: 95.34 63.96 40.16` on 12 cores, against 2.8-4.0 on a quiet one. Read this as
# cost, not as a bound -- there is no budget on `pnpm test` anywhere in this repo.
#
# Since `asc-09wx.14` the runner also appends one row per run to `.ascend/gate-runs.jsonl`
# (machine-local, gitignored), so this cost is attributable to a step rather than argued about.

(
  set -eu
  ROOT="$(git rev-parse --show-toplevel)"
  cd "$ROOT"
  node scripts/gate.mjs
)
status=$?

if [ "$status" -ne 0 ]; then
  echo "[pre-commit] ascend gate FAILED (exit $status) -- commit blocked" >&2
  exit 1
fi

echo "[pre-commit] ascend gate ok"

# --- BEGIN BEADS INTEGRATION v1.2.2 ---
# This section is managed by beads. Do not remove these markers.
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  _bd_timeout=${BEADS_HOOK_TIMEOUT:-300}
  _bd_used_perl=0
  if command -v timeout >/dev/null 2>&1; then
    timeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  elif command -v perl >/dev/null 2>&1; then
    _bd_used_perl=1
    perl -e 'alarm shift; exec @ARGV' "$_bd_timeout" bd hooks run pre-commit "$@"
    _bd_exit=$?
  else
    echo >&2 "beads: hook 'pre-commit' running without timeout; install coreutils or perl to enable BEADS_HOOK_TIMEOUT"
    bd hooks run pre-commit "$@"
    _bd_exit=$?
  fi
  if [ $_bd_exit -eq 124 ] || { [ $_bd_used_perl -eq 1 ] && [ $_bd_exit -eq 142 ]; }; then
    echo >&2 "beads: hook 'pre-commit' timed out after ${_bd_timeout}s — continuing without beads"
    _bd_exit=0
  fi
  if [ $_bd_exit -eq 3 ]; then
    echo >&2 "beads: database not initialized — skipping hook 'pre-commit'"
    _bd_exit=0
  fi
  if [ $_bd_exit -ne 0 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION v1.2.2 ---
