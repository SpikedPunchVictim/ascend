{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    /**
     * The base sets `types: []`, which is load-bearing for the PURE packages:
     * with no ambient Node types, `packages/core` and `packages/analysis` cannot
     * reach `process`, `Buffer` or `fs` without an explicit import that lint and
     * align would both reject.
     *
     * The adapter is a boundary package -- it reads the filesystem -- so it opts
     * back in, exactly as `store` does. Note that opting in here does NOT give
     * the adapter leave to reach SQLite: align's `node:sqlite` ban for
     * `adapterClaudeCode` is a separate rule and still fires.
     */
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../core" }]
}
