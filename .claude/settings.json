{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/bd-prime-hook.mjs\" ] || node \"$CLAUDE_PROJECT_DIR/.claude/bd-prime-hook.mjs\"",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/ascend-hook.sh\" ] || sh \"$CLAUDE_PROJECT_DIR/.claude/ascend-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/.claude/ascend-hook.sh\" ] || sh \"$CLAUDE_PROJECT_DIR/.claude/ascend-hook.sh\" post-tool-use"
          }
        ]
      }
    ]
  }
}
