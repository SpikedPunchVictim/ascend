{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    /**
     * Load-bearing, not stylistic. ascend's three-state property model depends on
     * distinguishing "absent" from "present and undefined" -- that distinction is
     * the whole product (ARCHITECTURE.md, "Three-state property values"). This
     * flag makes the compiler enforce it at the type level.
     */
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  }
}
